@page "/tasks"
@rendermode InteractiveServer

@inject TaskFlow.Services.TaskService TaskService
@using TaskFlow.Models

<h1>My Tasks</h1>

<div class="task-form">
    <input type="text" @bind="newTitle" placeholder="New task..." />
    <input type="date" @bind="newDueDate" min="@today" />
    <select @bind="newPriority">
        <option value="@Priority.Low">Low</option>
        <option value="@Priority.Medium">Medium</option>
        <option value="@Priority.High">High</option>
    </select>
    <button @onclick="AddTask">Add</button>
</div>



<div class="filters">
    <button @onclick="() => currentFilter = Filter.All">All</button>
    <button @onclick="() => currentFilter = Filter.Active">Active</button>
    <button @onclick="() => currentFilter = Filter.Done">Done</button>
</div>

<ul class="task-list">


@foreach (var group in GroupedTasks)
{
    <h2 class="group-heading @(group.Key == "Overdue" ? "overdue" : "")">@group.Key</h2>
    <ul class="task-list">
        @foreach (var task in group.OrderBy(t => t.DueDate))
        {
            <li class="task-item @(task.IsCompleted ? "done" : "")">
                <input type="checkbox" checked="@task.IsCompleted" @onchange="() => Toggle(task.Id)" />
                <span class="task-title">@task.Title</span>
                <span class="task-date">@task.DueDate.ToString("dd MMM")</span>
                <span class="pill @PriorityClass(task.Priority)">@task.Priority</span>
                <button class="delete-btn" @onclick="() => DeleteTask(task.Id)">Delete</button>
            </li>
        }
    </ul>
}
</ul>

@code {

    private DateOnly newDueDate = DateOnly.FromDateTime(DateTime.Today);
    private string today = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");
    private Priority newPriority = Priority.Medium;
    private List<TaskItem> tasks = [];
    private string newTitle = "";
    

    private enum Filter {
        All,
        Active,
        Done
    } 
    private Filter currentFilter = Filter.All;

    

    protected override async Task OnInitializedAsync()
    {
        tasks = await TaskService.GetAllTasksAsync();
    }

    private async Task AddTask() {

        await TaskService.AddTaskAsync( new TaskItem
        {
        Title = newTitle,
        DueDate = newDueDate,
        Priority = newPriority
        });
        newTitle = "";
        tasks = await TaskService.GetAllTasksAsync();
    }

    private async Task Toggle(int taskId)
    {
        await TaskService.ToggleTaskCompletionAsync(taskId);
        tasks = await TaskService.GetAllTasksAsync();
    }
    private async Task DeleteTask(int taskId)
    {
        await TaskService.DeleteTaskAsync(taskId);
        tasks = await TaskService.GetAllTasksAsync();
    }

    private IEnumerable<TaskItem> FilterTasks()
    {
        return currentFilter switch
        {
            Filter.Active => tasks.Where(t => !t.IsCompleted),
            Filter.Done => tasks.Where(t => t.IsCompleted),
            _ => tasks
        };
    }

    private string PriorityClass(Priority p) => p switch
    {
    Priority.High => "pill-high",
    Priority.Medium => "pill-med",
    Priority.Low => "pill-low",
    _ => ""
    };  

    private static string GroupFor(TaskItem task)
{
    var today = DateOnly.FromDateTime(DateTime.Today);
    var weekEnd = today.AddDays(7);

    return task.DueDate switch
    {
        var d when d < today   => "Overdue",
        var d when d <= weekEnd => "This Week",
        _                       => "Weeks To Come"
    };
}
    private static readonly string[] GroupOrder = ["Overdue", "This Week", "Weeks To Come"];

private IEnumerable<IGrouping<string, TaskItem>> GroupedTasks =>
    FilterTasks()
        .GroupBy(GroupFor)
        .OrderBy(g => Array.IndexOf(GroupOrder, g.Key));


}

<style>
    .task-form { display: flex; gap: 8px; margin-bottom: 1.5rem; flex-wrap: wrap; }
    .task-form input[type="text"] {color: white; flex: 1; min-width: 180px; }

    .filters { display: flex; gap: 8px; margin-bottom: 1rem; }

    .task-list { list-style: none; padding: 0; margin: 0; }
    .task-item {
        display: flex;
        align-items: center;
        gap: 12px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 12px 16px;
        margin-bottom: 8px;
    }
    .task-item.done .task-title { text-decoration: line-through; color: var(--text-muted); }
    .task-title { flex: 1; }
    .task-date { color: var(--text-muted); font-size: 0.85rem; }


    .group-heading {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin: 1.5rem 0 0.5rem 0;
}
    .group-heading.overdue { color: var(--high-text); }

    .pill {
        font-size: 0.75rem;
        padding: 3px 10px;
        border-radius: 999px;
        font-weight: 500;
    }
    .pill-high { background: var(--high-bg); color: var(--high-text); }
    .pill-med  { background: var(--med-bg);  color: var(--med-text); }
    .pill-low  { background: var(--low-bg);  color: var(--low-text); }

    .delete-btn { border-color: transparent; color: var(--text-muted); padding: 4px 8px; }
    .delete-btn:hover { background: var(--high-bg); color: var(--high-text); }
</style>