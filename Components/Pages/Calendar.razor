@page "/calendar"
@rendermode InteractiveServer
@inject TaskFlow.Services.TaskService TaskService
@using TaskFlow.Models

<h1>@CurrentMonth @year</h1>

<div class="calendar-nav">
    <button @onclick="PreviousMonth">← Prev</button>
    <button @onclick="NextMonth">Next →</button>
</div>


<div class="calendar-header">
    <div>Mon</div><div>Tue</div><div>Wed</div>
    <div>Thu</div><div>Fri</div><div>Sat</div><div>Sun</div>
</div>

<div class="calendar-grid">
    @* Blank cells before day 1 *@
    @for (int i = 0; i < ShowBlanks; i++)
    {
        <div class="calendar-cell empty"></div>
    }

    @* One cell per day *@
    @for (int day = 1; day <= DaysInMonth; day++)
    {
        var date = new DateOnly(year, month, day);
        <div class="calendar-cell">
            <div class="day-number">@day</div>
            @if (tasksByDate.TryGetValue(date, out var dayTasks))
            {
                @foreach (var task in dayTasks)
                {
                    <div class="task-pill">
                    <span class="dot @PriorityClass(task.Priority)"></span>
        @task.Title
    </div>
                }
            }
        </div>
    }
</div>





@code {
    private int month = DateTime.Today.Month;
    private int year = DateTime.Today.Year;

    private Dictionary<DateOnly, List<TaskItem>> tasksByDate = new Dictionary<DateOnly, List<TaskItem>>();

    private string CurrentMonth => new DateOnly(year, month, 1).ToString("MMMM");
    protected override async Task OnInitializedAsync() => await Load();



    private async Task Load() =>
        tasksByDate = await TaskService.GetTasksForMonthAsync(year, month);


    private async Task PreviousMonth()
    {
        if (month == 1)
        {
            month = 12;
            year--;
        }

        else
        {
            month--;
        }
        await Load();
    }    

    private async Task NextMonth()
    {
        if (month == 12)
        {
            month = 1;
            year++;
        }

        else
        {
            month++;
        }
        await Load();
    }

    private int DaysInMonth => DateTime.DaysInMonth(year, month);

    private int ShowBlanks {
        get {
            var firstDay = new DateOnly(year, month, 1).DayOfWeek;
            return ((int) firstDay+6) % 7; // Adjusting so that Monday is the first day of the week
        }
    }

    private string PriorityClass(Priority p) => p switch
{
    Priority.High => "pill-high",
    Priority.Medium => "pill-med",
    Priority.Low => "pill-low",
    _ => "pill-low"
};
}


<style>
    .calendar-nav { display: flex; gap: 8px; align-items: center; margin-bottom: 1rem; }

    .calendar-header, .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        gap: 6px;
    }
    .calendar-header {
        margin-bottom: 6px;
    }
    .calendar-header > div {
        font-size: 0.8rem;
        color: var(--text-muted);
        padding: 0 4px;
    }
    .calendar-cell {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        min-height: 90px;
        padding: 6px;
    }
    .calendar-cell.empty {
        background: transparent;
        border: none;
    }
    .day-number {
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-bottom: 4px;
    }
    .task-pill {
    display: flex;
    align-items: center;
    gap: 6px;
    background: var(--border);
    color: var(--text);
    border-radius: 4px;
    padding: 3px 8px;
    margin-top: 3px;
    font-size: 0.72rem;
    min-width: 0;          
    overflow: hidden;
}

.task-pill .title-text {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
}

    .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
}
    .dot.pill-high { background: var(--high-text); }
    .dot.pill-med  { background: var(--med-text); }
    .dot.pill-low  { background: var(--low-text); }
</style>